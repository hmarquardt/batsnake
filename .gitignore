# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editors and local workspace state
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# Python tooling used for the local static server and verification scripts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# JavaScript tooling is not required by this project, but keep accidental
# local package-manager state out of the no-build repository.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example

# Test, profiling, and capture output
coverage/
.nyc_output/
playwright-report/
test-results/
screenshots/
captures/
*.cpuprofile
*.heapprofile

# Temporary and log files
*.log
*.tmp
*.temp
.cache/
tmp/
temp/

# Static-host and deployment caches
.jekyll-cache/
.sass-cache/
